PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/subscribers.sqlite
# Optional: comma-separated frontend origins if hosting the frontend separately.
# Same-origin requests through the Vite proxy or Express need no CORS setting.
FRONTEND_ORIGINS=
# Set only to match a known hosting proxy configuration (e.g. 1 for one proxy).
TRUST_PROXY=0
# Optional: serve a built frontend from an explicit path. Leave empty for API-only hosting.
FRONTEND_DIST=
